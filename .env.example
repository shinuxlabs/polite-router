# Required for the cloud bot (Vercel)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
XAI_API_KEY=

# Optional
XAI_MODEL=grok-4.5
PR_MAX_PAGES=15
PR_MAX_REQUESTS=30
PR_BOT_NAME=PoliteRouter
PR_CONTACT=

# Only for local Socket Mode (python app.py)
SLACK_APP_TOKEN=xapp-your-app-level-token
PR_FRESH_MINS=60
PR_CACHE_DIR=.router_cache
